# Wybór dostawcy LLM: "anthropic", "gemini" albo "ollama" (lokalny model, bez klucza)
LLM_PROVIDER=anthropic

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# --- Google Gemini (darmowy tier, model Flash) ---
# Klucz z https://aistudio.google.com/apikey
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.5-flash

# Port serwera HTTP API
PORT=3000

# --- Ollama (lokalny model, bez klucza API) ---
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5vl:3b
